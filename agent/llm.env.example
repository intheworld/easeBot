# Copy to agent/.env and edit, then: set -a; source agent/.env; set +a
# This file is not loaded automatically. Never commit your actual API key.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=your-model-id
LLM_API_KEY=
LLM_TIMEOUT_SEC=60
LLM_RESPONSE_FORMAT=json
# true inherits proxy and CA environment variables; false connects directly
# and also ignores SSL_CERT_FILE/SSL_CERT_DIR. Use false for local APIs if needed.
LLM_TRUST_ENV=true
# A local OpenAI-compatible service may omit the key. Include /v1 if it needs it.
# LLM_BASE_URL=http://192.168.1.10:8000/v1
# LLM_RESPONSE_FORMAT=text
