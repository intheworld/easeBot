{
  "schema": "hei_agent.graph/v1",
  "name": "execute_current_right_tcp_position",
  "entry": "pose",
  "max_steps": 6,
  "timeout_sec": 450,
  "nodes": [
    {
      "id": "pose",
      "kind": "skill",
      "inputs": {
        "skill": "get_arm_pose",
        "arguments": {
          "side": "right",
          "frame_id": "a_right_base_link"
        }
      }
    },
    {
      "id": "plan",
      "kind": "skill",
      "timeout_sec": 95,
      "inputs": {
        "skill": "plan_arm_position",
        "arguments": {
          "side": "right",
          "frame_id": "a_right_base_link",
          "path_mode": "joint",
          "x_m": {
            "$ref": "nodes.pose.x_m"
          },
          "y_m": {
            "$ref": "nodes.pose.y_m"
          },
          "z_m": {
            "$ref": "nodes.pose.z_m"
          }
        }
      }
    },
    {
      "id": "valid",
      "kind": "branch",
      "inputs": {
        "condition": {
          "$ref": "nodes.plan.validated"
        }
      }
    },
    {
      "id": "execute",
      "kind": "skill",
      "timeout_sec": 305,
      "inputs": {
        "skill": "execute_arm_plan",
        "arguments": {
          "plan_id": {
            "$ref": "nodes.plan.plan_id"
          }
        }
      }
    },
    {
      "id": "done",
      "kind": "end",
      "inputs": {
        "status": "succeeded",
        "message": "TCP goal completed; measured endpoint verified",
        "outputs": {
          "frame_id": {
            "$ref": "nodes.execute.frame_id"
          },
          "x_m": {
            "$ref": "nodes.execute.x_m"
          },
          "y_m": {
            "$ref": "nodes.execute.y_m"
          },
          "z_m": {
            "$ref": "nodes.execute.z_m"
          },
          "position_error_m": {
            "$ref": "nodes.execute.position_error_m"
          },
          "orientation_error_rad": {
            "$ref": "nodes.execute.orientation_error_rad"
          },
          "reached_goal": {
            "$ref": "nodes.execute.reached_goal"
          }
        }
      }
    },
    {
      "id": "failed",
      "kind": "end",
      "inputs": {
        "status": "failed",
        "message": "Arm plan collision/scene validation failed; inspect plan_ref",
        "outputs": {
          "plan_ref": {
            "$ref": "nodes.plan.plan_ref"
          },
          "validation_status": {
            "$ref": "nodes.plan.validation_status"
          }
        }
      }
    }
  ],
  "edges": [
    {
      "source": "pose",
      "target": "plan"
    },
    {
      "source": "plan",
      "target": "valid"
    },
    {
      "source": "valid",
      "target": "execute",
      "on": "true"
    },
    {
      "source": "valid",
      "target": "failed",
      "on": "false"
    },
    {
      "source": "execute",
      "target": "done"
    }
  ]
}
