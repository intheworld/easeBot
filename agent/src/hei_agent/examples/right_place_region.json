{
  "schema": "hei_agent.graph/v1",
  "name": "right_place_region",
  "entry": "place_capture",
  "max_steps": 12,
  "timeout_sec": 900,
  "nodes": [
    {
      "id": "place_capture",
      "kind": "skill",
      "timeout_sec": 10,
      "inputs": {
        "skill": "get_camera_observation",
        "arguments": {
          "camera": "front"
        }
      }
    },
    {
      "id": "place_region",
      "kind": "skill",
      "timeout_sec": 95,
      "inputs": {
        "skill": "perceive_place_region",
        "arguments": {
          "observation_id": {
            "$ref": "nodes.place_capture.observation_id"
          },
          "target": {
            "$ref": "inputs.destination"
          },
          "relation": {
            "$ref": "inputs.relation"
          }
        }
      }
    },
    {
      "id": "place_plan",
      "kind": "skill",
      "timeout_sec": 185,
      "inputs": {
        "skill": "plan_object_placement",
        "arguments": {
          "side": "right",
          "region_id": {
            "$ref": "nodes.place_region.region_id"
          },
          "approach_height_m": {
            "$ref": "inputs.approach_height_m"
          },
          "retreat_height_m": {
            "$ref": "inputs.retreat_height_m"
          },
          "release_gap_m": {
            "$ref": "inputs.release_gap_m"
          }
        }
      }
    },
    {
      "id": "place_valid",
      "kind": "branch",
      "inputs": {
        "condition": {
          "$ref": "nodes.place_plan.validated"
        }
      }
    },
    {
      "id": "place",
      "kind": "skill",
      "timeout_sec": 605,
      "inputs": {
        "skill": "execute_place_plan",
        "arguments": {
          "plan_id": {
            "$ref": "nodes.place_plan.plan_id"
          }
        }
      }
    },
    {
      "id": "done",
      "kind": "end",
      "inputs": {
        "status": "succeeded",
        "message": "Pick/place command sequence completed; physical capture and placement unverified",
        "outputs": {
          "placed": {
            "$ref": "nodes.place.placed"
          },
          "retracted": {
            "$ref": "nodes.place.retracted"
          },
          "placement_verified": {
            "$ref": "nodes.place.placement_verified"
          }
        }
      }
    },
    {
      "id": "place_failed",
      "kind": "end",
      "inputs": {
        "status": "failed",
        "message": "Placement path rejected; object was not automatically released",
        "outputs": {
          "plan_ref": {
            "$ref": "nodes.place_plan.plan_ref"
          }
        }
      }
    }
  ],
  "edges": [
    {
      "source": "place_capture",
      "target": "place_region"
    },
    {
      "source": "place_region",
      "target": "place_plan"
    },
    {
      "source": "place_plan",
      "target": "place_valid"
    },
    {
      "source": "place_valid",
      "target": "place",
      "on": "true"
    },
    {
      "source": "place_valid",
      "target": "place_failed",
      "on": "false"
    },
    {
      "source": "place",
      "target": "done"
    }
  ]
}
