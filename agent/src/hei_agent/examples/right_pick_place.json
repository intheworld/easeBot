{
  "schema": "hei_agent.graph/v1",
  "name": "right_pick_place",
  "entry": "capture",
  "max_steps": 20,
  "timeout_sec": 1200,
  "nodes": [
    {
      "id": "capture",
      "kind": "skill",
      "inputs": {
        "skill": "get_camera_observation",
        "arguments": {
          "camera": "front"
        }
      }
    },
    {
      "id": "perceive",
      "kind": "skill",
      "timeout_sec": 95,
      "inputs": {
        "skill": "perceive_grasp_target",
        "arguments": {
          "observation_id": {
            "$ref": "nodes.capture.observation_id"
          },
          "target": {
            "$ref": "inputs.target"
          }
        }
      }
    },
    {
      "id": "plan",
      "kind": "skill",
      "timeout_sec": 185,
      "inputs": {
        "skill": "plan_right_grasp_from_object",
        "arguments": {
          "object_id": {
            "$ref": "nodes.perceive.object_id"
          }
        }
      }
    },
    {
      "id": "valid",
      "kind": "branch",
      "inputs": {
        "condition": {
          "$ref": "nodes.plan.validated"
        }
      }
    },
    {
      "id": "execute",
      "kind": "skill",
      "timeout_sec": 305,
      "inputs": {
        "skill": "execute_right_grasp",
        "arguments": {
          "plan_id": {
            "$ref": "nodes.plan.plan_id"
          }
        }
      }
    },
    {
      "id": "failed",
      "kind": "end",
      "inputs": {
        "status": "failed",
        "message": "Grasp collision or scene validation failed; inspect plan_ref",
        "outputs": {
          "plan_ref": {
            "$ref": "nodes.plan.plan_ref"
          },
          "validation_status": {
            "$ref": "nodes.plan.validation_status"
          }
        }
      }
    },
    {
      "id": "place_plan",
      "kind": "skill",
      "timeout_sec": 185,
      "inputs": {
        "skill": "plan_place_object",
        "arguments": {
          "side": "right",
          "frame_id": {
            "$ref": "inputs.frame_id"
          },
          "x_m": {
            "$ref": "inputs.x_m"
          },
          "y_m": {
            "$ref": "inputs.y_m"
          },
          "support_z_m": {
            "$ref": "inputs.support_z_m"
          },
          "approach_height_m": {
            "$ref": "inputs.approach_height_m"
          },
          "retreat_height_m": {
            "$ref": "inputs.retreat_height_m"
          },
          "release_gap_m": {
            "$ref": "inputs.release_gap_m"
          }
        }
      }
    },
    {
      "id": "place_valid",
      "kind": "branch",
      "inputs": {
        "condition": {
          "$ref": "nodes.place_plan.validated"
        }
      }
    },
    {
      "id": "place",
      "kind": "skill",
      "timeout_sec": 605,
      "inputs": {
        "skill": "execute_place_plan",
        "arguments": {
          "plan_id": {
            "$ref": "nodes.place_plan.plan_id"
          }
        }
      }
    },
    {
      "id": "done",
      "kind": "end",
      "inputs": {
        "status": "succeeded",
        "message": "Pick/place command sequence completed; physical capture and placement unverified",
        "outputs": {
          "placed": {
            "$ref": "nodes.place.placed"
          },
          "retracted": {
            "$ref": "nodes.place.retracted"
          },
          "placement_verified": {
            "$ref": "nodes.place.placement_verified"
          }
        }
      }
    },
    {
      "id": "place_failed",
      "kind": "end",
      "inputs": {
        "status": "failed",
        "message": "Placement path rejected; object was not automatically released",
        "outputs": {
          "plan_ref": {
            "$ref": "nodes.place_plan.plan_ref"
          }
        }
      }
    }
  ],
  "edges": [
    {
      "source": "capture",
      "target": "perceive"
    },
    {
      "source": "perceive",
      "target": "plan"
    },
    {
      "source": "plan",
      "target": "valid"
    },
    {
      "source": "valid",
      "target": "execute",
      "on": "true"
    },
    {
      "source": "valid",
      "target": "failed",
      "on": "false"
    },
    {
      "source": "execute",
      "target": "place_plan"
    },
    {
      "source": "place_plan",
      "target": "place_valid"
    },
    {
      "source": "place_valid",
      "target": "place",
      "on": "true"
    },
    {
      "source": "place_valid",
      "target": "place_failed",
      "on": "false"
    },
    {
      "source": "place",
      "target": "done"
    }
  ]
}
