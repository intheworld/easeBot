<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="hei_damiao_arm">
  <xacro:arg name="config_file" default=""/>
  <xacro:arg name="hardware_name" default="HeiDamiaoArm"/>
  <xacro:arg name="include_gripper" default="true"/>
  <xacro:arg name="arm_read_only" default="false"/>
  <xacro:arg name="read_only" default="true"/>
  <xacro:arg name="configure_control_mode" default="false"/>
  <xacro:include filename="$(find hei_description)/urdf/hei_body.urdf"/>
  <xacro:property name="config" value="${xacro.load_yaml('$(arg config_file)')}"/>
  <xacro:macro name="damiao_motors" params="items kind:=joint commands:=true">
    <xacro:if value="${len(items) > 0}">
      <xacro:property name="motor" value="${items[0]}"/>
      <xacro:element xacro:name="${kind}" name="${motor['name']}">
        <param name="motor_id">${motor['motor_id']}</param>
        <param name="feedback_id">${motor['feedback_id']}</param>
        <param name="model">${motor['model']}</param>
        <param name="direction">${motor['direction']}</param>
        <param name="offset">${motor['offset']}</param>
        <param name="gear_ratio">${motor['gear_ratio']}</param>
        <param name="p_max">${motor['p_max']}</param>
        <param name="v_max">${motor['v_max']}</param>
        <param name="t_max">${motor['t_max']}</param>
        <xacro:if value="${kind == 'gpio'}">
          <param name="control_mode">torque_pos</param>
          <param name="current_ratio_limit">${motor['current_ratio_limit']}</param>
          <param name="torque_limit_nm">${motor['torque_limit_nm']}</param>
        </xacro:if>
        <param name="velocity_limit">${motor['velocity_limit']}</param>
        <xacro:unless value="$(arg read_only)">
          <xacro:if value="${commands}">
          <command_interface name="position">
            <param name="min">${motor['minimum']}</param>
            <param name="max">${motor['maximum']}</param>
          </command_interface>
          <xacro:if value="${kind == 'gpio'}">
            <command_interface name="velocity"/>
            <command_interface name="current_ratio"/>
            <command_interface name="enabled"/>
          </xacro:if>
          </xacro:if>
        </xacro:unless>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <xacro:if value="${kind == 'gpio'}"><state_interface name="enabled"/><state_interface name="feedback_sequence"/></xacro:if>
      </xacro:element>
      <xacro:damiao_motors items="${items[1:]}" kind="${kind}" commands="${commands}"/>
    </xacro:if>
  </xacro:macro>
  <ros2_control name="$(arg hardware_name)" type="system">
    <hardware>
      <plugin>hei_hardware/DamiaoSystem</plugin>
      <param name="port">${config['port']}</param>
      <param name="baud">${config['baud']}</param>
      <param name="read_only">$(arg read_only)</param>
      <param name="configure_control_mode">$(arg configure_control_mode)</param>
      <param name="feedback_timeout_ms">${config['feedback_timeout_ms']}</param>
      <param name="configure_timeout_ms">${config['configure_timeout_ms']}</param>
    </hardware>
    <xacro:if value="$(arg arm_read_only)">
      <xacro:damiao_motors items="${config['motors']}" commands="${False}"/>
    </xacro:if>
    <xacro:unless value="$(arg arm_read_only)">
      <xacro:damiao_motors items="${config['motors']}"/>
    </xacro:unless>
    <xacro:if value="$(arg include_gripper)">
      <xacro:damiao_motors items="${[config['gripper']]}" kind="gpio"/>
    </xacro:if>
  </ros2_control>
</robot>
